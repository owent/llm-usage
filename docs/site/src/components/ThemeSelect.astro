---
import Select from '@astrojs/starlight/components/Select.astro';
---
<starlight-theme-select>
  <Select
    icon="laptop"
    label={Astro.locals.t('themeSelect.accessibleLabel')}
    options={[
      { label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
      { label: Astro.locals.t('themeSelect.dark'), selected: false, value: 'dark' },
      { label: Astro.locals.t('themeSelect.auto'), selected: true, value: 'auto' },
    ]}
    width="7em"
  />
</starlight-theme-select>
<script is:inline>window.LLMUsageDocsTheme.updatePickers();</script>
<script>
  document.addEventListener('change', event => {
    const select = event.target;
    if (!(select instanceof HTMLSelectElement) || !select.closest('starlight-theme-select')) return;
    const choice = select.value === 'light' || select.value === 'dark' ? select.value : 'auto';
    window.LLMUsageDocsTheme.apply(choice, true);
  });
</script>
