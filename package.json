{
  "name": "llm-usage",
  "version": "0.3.0",
  "private": true,
  "description": "Doc tooling and root command entry for the llm-usage repository; the desktop app keeps its own manifest under desktop/.",
  "scripts": {
    "postinstall": "node -e \"process.env.CI || require('child_process').execSync('npm --prefix desktop install', { stdio: 'inherit' })\"",
    "setup": "npm install && npm --prefix desktop install",
    "assets:generate": "node desktop/scripts/assets.mjs --generate",
    "assets:check": "node desktop/scripts/assets.mjs --check",
    "lint:md": "markdownlint-cli2",
    "dev:docs": "node docs/site/scripts/prepare.mjs && astro dev --root docs/site --host 127.0.0.1",
    "build:docs": "node docs/site/scripts/prepare.mjs && astro build --root docs/site && node docs/site/scripts/check-output.mjs",
    "check:docs": "node docs/site/scripts/check-content.mjs && astro check --root docs/site",
    "test:docs": "node --test docs/site/tests/*.test.mjs",
    "test:docs:browser": "node docs/site/tests/browser.mjs",
    "docs:screenshots": "node docs/site/scripts/screenshots.mjs",
    "docs:review": "node docs/site/scripts/review-translations.mjs",
    "docs:comments:review": "node docs/site/scripts/review-comments.mjs",
    "check": "npm --prefix desktop run check",
    "build:web": "npm --prefix desktop run build",
    "build:desktop": "npm --prefix desktop run tauri -- build",
    "pack:desktop": "npm run assets:check && npm run check && npm run build:desktop",
    "dev:web": "npm --prefix desktop run dev",
    "dev:desktop": "npm --prefix desktop run tauri -- dev",
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --locked",
    "test:scripts": "node --test desktop/scripts/*.test.mjs",
    "test:ui": "node --experimental-strip-types --test desktop/tests/*.test.mjs",
    "test:browser": "node desktop/tests/browser-smoke.mjs",
    "test:desktop": "node desktop/tests/native-smoke.mjs",
    "test:receiver": "node desktop/tests/native-receiver-auth.mjs",
    "test:credentials:linux": "node desktop/tests/linux-credential-store.mjs",
    "test:install:windows": "node desktop/tests/windows-install-lifecycle.mjs",
    "test:update:windows": "node desktop/tests/windows-update.mjs",
    "test:install:linux": "node desktop/tests/linux-install-lifecycle.mjs",
    "test:import": "node desktop/tests/native-first-import.mjs",
    "test:headless": "node desktop/tests/headless-smoke.mjs",
    "clippy": "cargo clippy --manifest-path desktop/src-tauri/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path desktop/src-tauri/Cargo.toml --all --check",
    "verify": "npm run lint:md && npm run assets:check && npm run test:scripts && npm run test:ui && npm run check && npm run fmt:check && npm run clippy && npm run test:rust && npm run build:web"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.6",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "github-slugger": "^2.0.0",
    "markdownlint-cli2": "^0.23.3",
    "yaml": "^2.9.1"
  }
}
