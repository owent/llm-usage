{
  "name": "llm-usage",
  "version": "0.0.0",
  "private": true,
  "description": "Doc tooling and root command entry for the llm-usage repository; the desktop app keeps its own manifest under desktop/.",
  "scripts": {
    "assets:generate": "node desktop/scripts/assets.mjs --generate",
    "assets:check": "node desktop/scripts/assets.mjs --check",
    "lint:md": "markdownlint-cli2",
    "check": "npm --prefix desktop run check",
    "build:web": "npm --prefix desktop run build",
    "build:desktop": "npm --prefix desktop run tauri -- build",
    "dev:web": "npm --prefix desktop run dev",
    "dev:desktop": "npm --prefix desktop run tauri -- dev",
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --locked",
    "test:scripts": "node --test desktop/scripts/*.test.mjs",
    "clippy": "cargo clippy --manifest-path desktop/src-tauri/Cargo.toml --locked -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path desktop/src-tauri/Cargo.toml --check",
    "verify": "npm run lint:md && npm run assets:check && npm run test:scripts && npm run check && npm run fmt:check && npm run clippy && npm run test:rust && npm run build:web"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3"
  }
}
