{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llm-usage-m0",
  "version": "0.1.0",
  "identifier": "com.llmusage.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "llm-usage-m0",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app"],
    "resources": { "../sample-data.txt": "sample-data.txt" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
